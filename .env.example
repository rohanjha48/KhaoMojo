# ==========================================
# KhaoMojo Environment Configuration
# ==========================================

# Your Supabase Project URL (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase Anon Public Key (found in Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Secret PIN to access /admin dashboard (Default: khaopiyoashkaro)
NEXT_PUBLIC_ADMIN_PIN=khaopiyoashkaro

# Telegram Bot Instant Order Notifications
# (Obtain token from @BotFather, and your chat ID from @userinfobot or channel ID)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=your-telegram-chat-id-here
